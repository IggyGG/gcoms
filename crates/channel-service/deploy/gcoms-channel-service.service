[Unit]
Description=GComs ciphertext-only hosted channels
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=gcoms-channels
Group=gcoms-channels
UMask=0077
StateDirectory=gcoms-channels
StateDirectoryMode=0700
ExecStart=/usr/local/lib/gcoms-channels/current/gcoms-channel-service /etc/gcoms-channels/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
Environment=TOKIO_WORKER_THREADS=4
MemoryMax=2G
CPUQuota=200%
TasksMax=32
LimitNOFILE=2048
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
